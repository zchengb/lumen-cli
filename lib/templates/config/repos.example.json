{
  "repositories": [
    {
      "name": "service-a",
      "path": "/absolute/path/to/service-a",
      "default_branch": "main",
      "runtime_profile": "local-java-review-only",
      "allow_auto_fix": true,
      "automation": {
        "scan": {
          "allow_auto_fix": true
        },
        "delivery": {
          "enabled": true
        },
        "patch": {
          "enabled": true
        }
      }
    },
    {
      "name": "web-or-mobile-app",
      "path": "/absolute/path/to/web-or-mobile-app",
      "default_branch": "master",
      "runtime_profile": "local-react-native-review-only",
      "allow_auto_fix": true,
      "automation": {
        "scan": {
          "allow_auto_fix": true
        },
        "delivery": {
          "enabled": true
        },
        "patch": {
          "enabled": true
        }
      }
    }
  ]
}

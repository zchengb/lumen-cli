{
  "enabled": false,
  "profiles": {
    "dylan": {
      "role": "scan",
      "workflow": "auto_scan"
    },
    "mark": {
      "role": "delivery",
      "workflow": "auto_delivery"
    }
  },
  "dylan": {
    "max_concurrent_jobs": 3,
    "conversation_v4": {
      "enabled": false,
      "mode": "autonomous_workspace",
      "provider": {
        "type": "cursor_cli",
        "model": "cursor-grok-4.5-medium",
        "output_format": "stream-json",
        "resume_sessions": true
      },
      "session": {
        "scope": "thread_shared",
        "idle_after_hours": 24,
        "archive_after_days": 30,
        "reset_on_workspace_change": true
      },
      "workspace": {
        "stable_path_required": true,
        "generate_agents_md": true,
        "permission_profile": "workspace_autonomous"
      },
      "runtime": {
        "soft_timeout_seconds": 90,
        "hard_timeout_seconds": 300,
        "max_concurrent_sessions": 3,
        "serialize_same_session": true
      },
      "reaction": {
        "enabled": true,
        "emoji_type": "Typing",
        "add_immediately": true,
        "remove_on_success": true,
        "remove_on_failure": true,
        "cleanup_after_seconds": 120
      },
      "observability": {
        "log_level": "INFO",
        "jsonl_enabled": true,
        "trace_enabled": true,
        "record_tool_events": true,
        "record_assistant_deltas": false,
        "redact_secrets": true
      },
      "soul": {
        "version": "2",
        "bootstrap_once": true
      }
    },
    "conversation_v3": {
      "enabled": false,
      "routing_mode": "agent_only",
      "model": {
        "provider": "cursor",
        "model": "cursor-grok-4.5-medium",
        "planner_timeout_seconds": 45,
        "responder_timeout_seconds": 60,
        "max_planner_retries": 1,
        "max_responder_retries": 1,
        "required": true
      },
      "agent_loop": {
        "max_iterations": 2,
        "max_tool_calls": 8,
        "max_total_tool_seconds": 20,
        "allow_multi_task": true
      },
      "reaction": {
        "enabled": true,
        "emoji_type": "Typing",
        "add_immediately": true,
        "remove_on_success": true,
        "remove_on_failure": true,
        "cleanup_after_seconds": 120
      },
      "observability": {
        "log_level": "INFO",
        "jsonl_enabled": true,
        "trace_enabled": true,
        "store_model_io": false,
        "model_io_retention_days": 3,
        "redact_secrets": true
      }
    },
    "risk_analyst": {
      "enabled": false,
      "conversation_v2": {
        "enabled": false,
        "llm_router_enabled": false,
        "llm_response_enabled": false,
        "grounding_guard_enabled": true,
        "model": {
          "provider": "cursor",
          "router_timeout_seconds": 8,
          "response_timeout_seconds": 25,
          "max_router_retries": 1,
          "max_response_retries": 1
        },
        "typing": {
          "enabled": true,
          "delay_ms": 350,
          "progress_after_ms": 5000,
          "long_wait_after_ms": 15000,
          "overall_timeout_ms": 45000,
          "max_updates": 4
        }
      }
    }
  },
  "mark": {
    "max_concurrent_jobs": 3,
    "conversation_v4": {
      "enabled": false,
      "mode": "autonomous_workspace",
      "provider": {
        "type": "cursor_cli",
        "model": "cursor-grok-4.5-medium",
        "output_format": "stream-json",
        "resume_sessions": true
      },
      "session": {
        "scope": "thread_shared",
        "idle_after_hours": 24,
        "archive_after_days": 30,
        "reset_on_workspace_change": true
      },
      "workspace": {
        "stable_path_required": true,
        "generate_agents_md": true,
        "permission_profile": "delivery_conversational"
      },
      "runtime": {
        "soft_timeout_seconds": 90,
        "hard_timeout_seconds": 300,
        "max_concurrent_sessions": 3,
        "serialize_same_session": true
      },
      "reaction": {
        "enabled": true,
        "emoji_type": "Typing",
        "add_immediately": true,
        "remove_on_success": true,
        "remove_on_failure": true,
        "cleanup_after_seconds": 120
      },
      "observability": {
        "log_level": "INFO",
        "jsonl_enabled": true,
        "trace_enabled": true,
        "record_tool_events": true,
        "record_assistant_deltas": false,
        "redact_secrets": true
      },
      "soul": {
        "version": "1",
        "bootstrap_once": true
      }
    }
  },
  "notifications": {
    "mode": "legacy",
    "fallback_to_legacy_webhook": true
  }
}
